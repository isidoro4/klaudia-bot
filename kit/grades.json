{
  "_how": "One colour for the whole video, so stills and clips (made by different models) look like one film. The person picks it from sheets/grades.png by number. The edit applies it to every shot (klaudia_edit.py --grade <id>, or the board's style.grade).",
  "grades": [
    {"id": "none", "label": "1 · As shot", "ffmpeg": ""},
    {"id": "film", "label": "2 · Warm film", "ffmpeg": "colorbalance=rs=.05:bs=-.05:rm=.03:bm=-.03,eq=contrast=1.06:saturation=1.08"},
    {"id": "cold", "label": "3 · Cold blue", "ffmpeg": "colorbalance=rs=-.06:bs=.08:rh=-.03:bh=.05,eq=contrast=1.08:saturation=0.9"},
    {"id": "pop", "label": "4 · Bright pop", "ffmpeg": "eq=saturation=1.4:contrast=1.12:brightness=0.02"},
    {"id": "vhs", "label": "5 · Old video", "ffmpeg": "eq=saturation=1.3:contrast=0.95,gblur=sigma=0.9,colorbalance=rs=.04:bs=.04,noise=alls=8:allf=u"},
    {"id": "print", "label": "6 · Newspaper print", "ffmpeg": "eq=contrast=1.3:saturation=0.7,noise=alls=10:allf=u,vignette=PI/5"},
    {"id": "bw", "label": "7 · Black and white", "ffmpeg": "hue=s=0,eq=contrast=1.25:brightness=-0.02,noise=alls=7:allf=u"}
  ]
}
